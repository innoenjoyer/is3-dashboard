  ```tsx
  export function Arrow({ x1, y1, x2, y2, dashed, label, labelDy }: ...) {
    const angle = Math.atan2(y2 - y1, x2 - x1) * 180 / Math.PI
    // shorten line by 7px at end for arrowhead
    const len = Math.hypot(x2-x1, y2-y1)
    const ex = x2 - (7 * (x2-x1)) / len
    const ey = y2 - (7 * (y2-y1)) / len
    return (
      <g>
        <line x1={y1} ... className="stroke-text-muted" strokeWidth={1.5} strokeDasharray={dashed ? '4 3' : undefined} />
        <polygon points={`0,0 8,3.5 0,7`} transform={`translate(${x2} ${y2-3.5}) rotate(${angle})`} className="fill-text-muted" />
        {label && <text .../>}
      </g>
    )
  }
  ```

