  prng.ts: mulberry32 + helpers range, int, pick, normal-ish.

  ```ts
  export type Rng = () => number
  export function mulberry32(seed: number): Rng {
    let a = seed >>> 0
    return function () {
      a |= 0; a = (a + 0x6d2b79f5) | 0
      let t = Math.imul(a ^ (a >>> 15), 1 | a)
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296
    }
  }
  export function range(rng, min, max) { return min + rng() * (max - min) }
  export function int(rng, min, max) { return Math.floor(range(rng, min, max + 1)) }
  export function pick<T>(rng, items: readonly T[]): T { return items[Math.floor(rng() * items.length)] }
  export function normal(rng, mean, sd) { // sum of 3 uniforms approx
    return mean + (rng() + rng() + rng() - 1.5) / 1.5 * sd
  }
  ```

