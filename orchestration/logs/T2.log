  advanceFleet:

  ```ts
  export function advanceFleet(fleet: Device[], rng: Rng, toTime: number): Device[] {
    return fleet.map(d => {
      const st = simStates.get(d)
      if (!st || st.nextDueAt > toTime) return d
      const history = [...d.history]
      let latest = history[history.length-1]
      let changed = false
      while (st.nextDueAt <= toTime) {
        if (!(st.mode === 'flaky' && rng() < st.missRate)) {
          const target = st.mode === 'degraded' ? st.degradedBaseline : st.baseline
          const metrics = stepMetrics(d.kind, latest.metrics, target, rng, st.nextDueAt)
          latest = { deviceId: d.id, timestamp: st.nextDueAt, metrics }
          history.push(latest)
          changed = true
        }
        st.nextDueAt += d.expectedIntervalSec * 1000
      }
      if (!changed) return d
      const cutoff = toTime - HISTORY_HOURS*3600*1000
      let first = 0
      while (first < history.length && history[first].timestamp < cutoff) first++
      return { ...d, history: history.slice(first) }
    })
  }
  ```

