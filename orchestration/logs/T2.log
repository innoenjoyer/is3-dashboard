  ```ts
  function rollMode(rng: Rng): ProfileMode {
    const roll = rng()
    if (roll < 0.78) return 'healthy'
    if (roll < 0.86) return 'flaky'
    if (roll < 0.94) return 'degraded'
    if (roll < 0.97) return 'recovered'
    return 'offline'
  }
