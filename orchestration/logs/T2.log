  ```ts
  export function generateFleet(seed: number = FLEET_SEED, now: number = Date.now()): Device[] {
    const rng = mulberry32(seed)
    const end = Math.floor(now / (HISTORY_STEP_SEC*1000)) * HISTORY_STEP_SEC*1000
    const start = end - HISTORY_HOURS*3600*1000

    // site pool
    const sitePool: string[] = []
    SITES.forEach((s, i) => { for (let k=0;k<SITE_COUNTS[i];k++) sitePool.push(s.id) })
    // shuffle
    for (let i = sitePool.length-1; i>0; i--) { const j = Math.floor(rng()*(i+1)); [sitePool[i],sitePool[j]]=[sitePool[j],sitePool[i]] }

    const devices: Device[] = []
    const counters: Record<string, number> = {}
    let idx = 0
    for (const [kind, count] of KIND_PLAN) {
      for (let n = 0; n < count; n++) {
        const siteId = sitePool[idx++]
        const siteCode = ...
        const seq = (counters[siteCode+kind] = (counters[siteCode+kind] ?? 0) + 1)
        const id = `${PREFIX[kind]}-${siteCode}-${String(seq).padStart(3,'0')}`
        ...
      }
    }
    return devices
  }
  ```

