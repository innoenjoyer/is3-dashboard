  import { useEffect, useRef, useState } from 'react'
  import { metricStatus, type Device, type DeviceStatus } from '../../data'

  export const CHART_HOURS = 24
  export const BUCKET_MIN = 30
  export const BUCKET_MS = BUCKET_MIN * 60_000
  export const BUCKET_COUNT = (CHART_HOURS * 60) / BUCKET_MIN  // 48

  /** End-aligned 30-min bucket edges covering the last 24h before `now`. */
  export function bucketEdges(now: number): number[] {
    const end = Math.floor(now / BUCKET_MS) * BUCKET_MS  // hmm — live feed now advances 30s steps; floor to bucket makes the right edge up to 29 min stale. Better: end = now exactly.
    ...
